{
  "name": "@k1e1n04/mav",
  "version": "0.1.19",
  "description": "Multi-agent view — manage multiple AI CLI sessions in one terminal",
  "type": "module",
  "bin": {
    "mav": "./dist/bin/mav.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/k1e1n04/mav.git"
  },
  "files": [
    "dist/",
    "src/",
    "bin/",
    "lua/",
    "plugin/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/postbuild.mjs",
    "dev": "tsx bin/mav.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "13.1.0",
    "js-yaml": "4.1.0",
    "node-pty": "1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.15.21",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.2.0"
  }
}
